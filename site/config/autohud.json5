			"durabilityPercentage": 10,
			"onDamageChange": false,
			"onStackSizeChange": true,
			"maximumFadeHotbarItems": 0.0,
			"alwaysHidden": false,
			"onLowDurability": true,
			"maximumAlpha": 1.0,
			"durabilityTotal": 20,
			"dynamic": true
		},
		"minecraft:tooltip": {
			"minimumAlpha": 0.0,
			"alwaysHidden": true,
			"maximumAlpha": 1.0
		},
		"minecraft:subtitle": {
			"minimumAlpha": 0.0,
			"alwaysHidden": false,
			"maximumAlpha": 1.0
		},
		"minecraft:overlay_message": {
			"minimumAlpha": 0.0,
			"alwaysHidden": false,
			"maximumAlpha": 1.0,
			"dynamic": true
		},
