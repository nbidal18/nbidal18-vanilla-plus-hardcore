{
	"dynamicOnLoad": true,
	"ticksRevealed": 200,
	"animationMove": true,
	"animationFade": true,
	"animationSpeed": 2.0,
	"animationSpeeds": {
		"moveIn": 0.0,
		"moveOut": 0.0,
		"fadeIn": 0.0,
		"fadeOut": 0.0
	},
	"events": {
		"onScreenOpen": "Nothing",
		"onMoving": "Nothing",
		"onStandingStill": "Nothing",
		"onPauseScreen": "Nothing",
		"onSneaking": "Nothing",
		"onFlying": "Nothing",
		"onUsingItem": false,
		"onMining": false
	},
	"elements": {
		"minecraft:hotbar": {
			"maximumMoveHotbar": 1.0,
			"minimumAlpha": 0.0,
