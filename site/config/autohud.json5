			"maximumAlpha": 1.0,
			"dynamic": true
		},
		"minecraft:player_list": {
			"minimumAlpha": 0.0,
			"alwaysHidden": false,
			"maximumAlpha": 1.0
		},
		"minecraft:armor_bar": {
			"minimumAlpha": 0.0,
			"alwaysHidden": true,
			"maximumAlpha": 1.0,
			"dynamic": true,
			"revealWhenHoldingArmorItem": true,
			"policy": "Changing"
		},
		"minecraft:air_bar": {
			"minimumAlpha": 0.0,
